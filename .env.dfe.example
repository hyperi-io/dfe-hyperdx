# DFE dev overrides -- copy to .env.dfe (gitignored) and adjust.
# Consumed by `yarn dev:dfe` (compose --env-file + dotenvx -f).

# DocumentDB login (required by docker-compose.dfe.dev.yml), created on its
# first start. The gateway requires TLS with a SCRAM-SHA-256 login, on a
# self-signed certificate that tlsAllowInvalidCertificates accepts in dev only.
POSTGRES_USER=hyperdx
POSTGRES_PASSWORD=hyperdx
MONGO_URI=mongodb://hyperdx:hyperdx@localhost:27017/hyperdx?tls=true&tlsAllowInvalidCertificates=true&authMechanism=SCRAM-SHA-256

# DFE identity master switch: empty disables the /dfe/* identity layer,
# `oidc-proxy` verifies engine JWTs, `header-dev` trusts dev headers.
DFE_AUTH_MODE=

# Engine trust, used when DFE_AUTH_MODE is enabled. The engine's local boot
# serves JWKS at this path -- see dfe-engine docs/LOCAL-DEV.md.
DFE_ENGINE_JWKS_URL=http://localhost:8003/.well-known/jwks.json
DFE_ENGINE_ISSUER=https://dfe.local/api

# Optional: auto-provision a ClickHouse connection on team creation
# (array of {name, host, username, password}; omit to skip).
# DEFAULT_CONNECTIONS=[{"name":"local","host":"http://localhost:8123","username":"default","password":""}]
