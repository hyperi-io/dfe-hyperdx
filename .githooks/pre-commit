#!/usr/bin/env bash
#  Project:      dfe-hyperdx
#  File:         .githooks/pre-commit
#  Purpose:      Run the fork conflict-surface guard before every commit
#  Language:     Bash
#
#  License:      MIT (inherits upstream hyperdxio/hyperdx)
#
#  Enable once per clone:
#      git config core.hooksPath .githooks
#
#  Override for a single commit (when landing a documented exception):
#      FORK_SURFACE_WARN=1 git commit ...
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
checker="${hook_dir}/fork-surface-check.py"

if [[ ! -x "${checker}" ]]; then
  echo "fork-surface-check.py missing or not executable - skipping guard." >&2
else
  "${checker}"
fi

# Then hand off to husky. `core.hooksPath` is SINGLE-VALUED, so this hook and
# husky's were mutually exclusive: fork-setup.sh points it at .githooks and
# `yarn setup` points it at .husky, and whichever ran last silently disabled the
# other. You got the fork guard or you got lint-staged, never both, with nothing
# said either way. Chaining makes .githooks the single winner and loses nothing.
repo_root="$(git rev-parse --show-toplevel)"
husky_hook="${repo_root}/.husky/pre-commit"

if [[ -x "${husky_hook}" ]]; then
  if [[ -f "${repo_root}/.husky/_/husky.sh" ]]; then
    exec "${husky_hook}"
  fi
  # husky's scaffolding is generated by `husky install` and gitignored, so a
  # fresh clone has the hook but not what it sources. Warn rather than block:
  # CI runs these checks regardless, and a hook that fails a clean clone just
  # teaches people --no-verify.
  echo "husky not installed (.husky/_ missing) - lint-staged did NOT run." >&2
  echo "  fix with: yarn setup" >&2
fi
