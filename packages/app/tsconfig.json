{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useUnknownInCatchVariables": false,
    "jsx": "preserve",
    "types": ["@types/intercom-web", "jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@styles/*": ["styles/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "//dfe": "DFE: exclude the orphaned .dfe[CHG] page shadow copies. They are NOT wired into any build (pages import the pristine originals, e.g. @/DBSearchPage), and have drifted against upstream 2.29 (reference removed modules/types). Pending a decision to re-derive+wire or delete. Bracket-escaped for minimatch (literal [CHG]).",
  "exclude": [
    "node_modules",
    "**/*.dfe*.ts",
    "**/*.dfe*.tsx",
    "src/dfe/components/AppNav/**",
    "src/dfe/components/SidebarMenu/**"
  ]
}
